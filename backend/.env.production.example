# Server
NODE_ENV=production
PORT=5000
API_VERSION=v1

# Database
MONGODB_URI=mongodb+srv://blackholeinfiverse54_db_user:ZLKdHYga6UI3JLXZ@cluster1.gfwnwc3.mongodb.net/?appName=Cluster1

# Blackhole Auth (centralized SSO)
JWT_SECRET=blackhole-auth-super-secure-random-secret-min-32-chars
AUTH_SERVER_URL=https://bhiv-auth.onrender.com

# URL resolution (see backend/.env.example):
APP_URL=https://artha.blackholeinfiverse.com
FRONTEND_URL=https://artha.blackholeinfiverse.com
# Or SPA-only APP_URL on Vercel + API_PUBLIC_URL=https://artha.blackholeinfiverse.com
# APP_LOGIN_URL=https://artha.blackholeinfiverse.com/login
# JWT allowedApps must include this app id (configure on auth server for each user).
# APP_ID=artha

# Security (CHANGE THIS!)
HMAC_SECRET=YOUR_SUPER_SECRET_HMAC_KEY_FOR_LEDGER_CHAIN_MINIMUM_32_CHARACTERS

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Redis (Production Only)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=gK22JxYlv9HCpBBuNWpizNT1YjBOOoAD
REDIS_DB=0

# InsightCore (Optional)
INSIGHTCORE_ENDPOINT=http://your-insightcore-service/telemetry
INSIGHTCORE_ENABLED=false
INSIGHTCORE_API_KEY=

# Storage
STORAGE_TYPE=local
AWS_BUCKET_NAME=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# CORS_ALLOWED_ORIGINS=https://artha.blackholeinfiverse.com
# CORS_ORIGIN=https://artha.blackholeinfiverse.com
# Local Vite is allowed unless you set: ALLOW_LOCALHOST_CORS=false

# Admin Seed (managed by Blackhole Auth)
# Used by scripts/seed.js and scripts/initialize-database.js on first run
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=ChangeMe@123456

# Logging
LOG_LEVEL=info

# Tally Connector Ingestion (cloud side)
TALLY_CONNECTOR_API_KEY=your-api-key-here
TALLY_CONNECTOR_HMAC_SECRET=your-hmac-secret-here

# Push Notifications (VAPID) — generate with: npx web-push generate-vapid-keys
# Must match the public key the frontend uses (or is fetched from GET /api/v1/push/vapid-key)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key