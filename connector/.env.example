# Tally Gateway (read-only)
TALLY_HOST=127.0.0.1
TALLY_PORT=9000
TALLY_PROTOCOL=http
TALLY_COMPANY=Bright Connections - (from 1-Apr-24)
TALLY_TIMEOUT_MS=30000
TALLY_TENANT_ID=tenant_bright_connection_001

# Cloud ARTHA (destination)
# CLOUD_URL is the shared deployed ARTHA URL — the SAME URL works for every
# account. CLOUD_API_KEY / CLOUD_HMAC_SECRET are PER-ACCOUNT: each admin gets
# their own keys from ARTHA → Tally Connect → "Connect this account".
# Data pushed with your keys is visible ONLY in your account.
CLOUD_URL=https://artha.blackholeinfiverse.com
CLOUD_API_KEY=your-per-account-api-key-from-tally-connect-page
CLOUD_HMAC_SECRET=your-per-account-hmac-secret-from-tally-connect-page
CLOUD_TIMEOUT_MS=30000

# Sync Schedule
SYNC_INTERVAL_MINUTES=15
SYNC_DEFAULT_BACKFILL_DAYS=30
SYNC_BATCH_SIZE=50
SYNC_FROM_DATE=1-Apr-2024
SYNC_TO_DATE=31-Mar-2025
