# ── Core ──────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/notification
PORT=5100
# Required for server-to-server calls (send, register, unregister, status).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NOTIFICATION_API_KEY=change-me
# Optional: if set, browsers may authenticate with `Authorization: Bearer <JWT>`
# instead of the API key. JWT claims must include sub (user_id) and tenant_id.
NOTIFICATION_JWT_SECRET=

# ── Web Push (VAPID) ──────────────────────────────────────────────────
# Generate: npm run gen-vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com

# ── FCM HTTP v1 (Android + iOS devices registered via FCM SDK) ───────
# Path to a Firebase service-account JSON file, OR the JSON itself inline.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_KEY=

# ── APNs (iOS devices registered with a native APNs device token) ─────
# .p8 key from Apple Developer → Certificates, Identifiers & Profiles
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_KEY_PATH=./AuthKey.p8
# production | sandbox
APNS_ENV=production
